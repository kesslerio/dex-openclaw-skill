#!/usr/bin/env bash
# Delete a Dex reminder
# Usage: dex-reminder-delete <reminder-id>

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: dex-reminder-delete <reminder-id>" >&2
    exit 1
fi

REMINDER_ID="$1"

# Load DEX_API_KEY from environment
if [ -z "${DEX_API_KEY:-}" ]; then
    if [ -f ~/.moltbot/.env ]; then
        source ~/.moltbot/.env
    fi
fi

if [ -z "${DEX_API_KEY:-}" ]; then
    echo "Error: DEX_API_KEY not set" >&2
    exit 1
fi

RESPONSE=$(curl -w "\n%{http_code}" -X DELETE "https://api.getdex.com/api/rest/reminders/${REMINDER_ID}" \
  -H "Content-Type: application/json" \
  -H "x-hasura-dex-api-key: ${DEX_API_KEY}")

HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
BODY=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" -ge 200 ] && [ "$HTTP_CODE" -lt 300 ]; then
    echo "$BODY"
else
    echo "Error: HTTP $HTTP_CODE" >&2
    echo "$BODY" >&2
    exit 1
fi
