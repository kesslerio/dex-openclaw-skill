#!/usr/bin/env bash
# List Dex reminders with pagination
# Usage: dex-reminder-list [limit] [offset]

set -euo pipefail

LIMIT="${1:-10}"
OFFSET="${2:-0}"

# Load DEX_API_KEY from environment
if [ -z "${DEX_API_KEY:-}" ]; then
    if [ -f ~/.moltbot/.env ]; then
        source ~/.moltbot/.env
    fi
fi

if [ -z "${DEX_API_KEY:-}" ]; then
    echo "Error: DEX_API_KEY not set" >&2
    exit 1
fi

RESPONSE=$(curl -w "\n%{http_code}" -X GET "https://api.getdex.com/api/rest/reminders?limit=${LIMIT}&offset=${OFFSET}" \
  -H "Content-Type: application/json" \
  -H "x-hasura-dex-api-key: ${DEX_API_KEY}")

HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
BODY=$(echo "$RESPONSE" | sed '$d')

if [ "$HTTP_CODE" -ge 200 ] && [ "$HTTP_CODE" -lt 300 ]; then
    echo "$BODY"
else
    echo "Error: HTTP $HTTP_CODE" >&2
    echo "$BODY" >&2
    exit 1
fi
