#!/usr/bin/env bash
# List notes for a contact or all notes
# Usage: dex-note-list [contact-id]
#    If contact-id is provided, lists notes for that contact
#    Otherwise, lists all notes with pagination (limit/offset via env vars)

set -euo pipefail

# Load DEX_API_KEY from environment
if [ -z "${DEX_API_KEY:-}" ]; then
    if [ -f ~/.moltbot/.env ]; then
        source ~/.moltbot/.env
    fi
fi

if [ -z "${DEX_API_KEY:-}" ]; then
    echo "Error: DEX_API_KEY not set" >&2
    exit 1
fi

if [ $# -eq 1 ]; then
    # List notes for specific contact
    CONTACT_ID="$1"
    RESPONSE=$(curl -w "\n%{http_code}" -X GET "https://api.getdex.com/api/rest/timeline_items/contacts/${CONTACT_ID}" \
      -H "Content-Type: application/json" \
      -H "x-hasura-dex-api-key: ${DEX_API_KEY}" 2>&1)
else
    # List all notes with pagination
    LIMIT="${DEX_NOTE_LIMIT:-10}"
    OFFSET="${DEX_NOTE_OFFSET:-0}"
    RESPONSE=$(curl -w "\n%{http_code}" -X GET "https://api.getdex.com/api/rest/timeline_items?limit=${LIMIT}&offset=${OFFSET}" \
      -H "Content-Type: application/json" \
      -H "x-hasura-dex-api-key: ${DEX_API_KEY}" 2>&1)
fi

# Extract HTTP status code (last line)
HTTP_STATUS=$(echo "$RESPONSE" | tail -n1)
# Extract body (everything except last line)
BODY=$(echo "$RESPONSE" | sed '$d')

# Check HTTP status
case "$HTTP_STATUS" in
    200)
        echo "$BODY"
        exit 0
        ;;
    400)
        echo "Error: Bad request - invalid parameters" >&2
        echo "$BODY" >&2
        exit 1
        ;;
    401)
        echo "Error: Unauthorized - invalid API key" >&2
        exit 1
        ;;
    404)
        if [ $# -eq 1 ]; then
            echo "Error: Contact not found (ID: ${CONTACT_ID})" >&2
        else
            echo "Error: Resource not found" >&2
        fi
        exit 1
        ;;
    429)
        echo "Error: Rate limited - too many requests" >&2
        exit 1
        ;;
    5*)
        echo "Error: Server error (HTTP ${HTTP_STATUS})" >&2
        echo "$BODY" >&2
        exit 1
        ;;
    *)
        echo "Error: Unexpected response (HTTP ${HTTP_STATUS})" >&2
        echo "$BODY" >&2
        exit 1
        ;;
esac
